{
  "name": "oneflame-records",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/patch-zod-compat.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-audit-repairs.mjs && node scripts/test-security-boundaries.mjs && node scripts/test-studio-retirement.mjs && node scripts/test-email-studio.mjs && npm run test:partner",
    "postinstall": "node scripts/patch-zod-compat.mjs",
    "test:runtime-security": "node --test scripts/runtime-security-check.mjs",
    "check:runtime-security": "node scripts/patch-zod-compat.mjs --check && npm audit --omit=dev --audit-level=low",
    "test:transitive-security": "node --test scripts/transitive-security.test.mjs",
    "test:partner": "node scripts/test-flames-partner.mjs && node scripts/test-partner-actions.mjs && node scripts/test-partner-delivery.mjs && node scripts/test-partner-mail-worker.mjs && node scripts/test-partner-password-reset.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.56.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@types/marked": "^5.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "googleapis": "^173.0.0",
    "inngest": "4.21.1",
    "marked": "^18.0.4",
    "music-metadata": "^11.12.3",
    "next": "16.4.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "inngest": {
      "zod": "4.6.7"
    },
    "fast-uri@>=3 <3.1.9": "3.1.9",
    "qs@>=6.7.0 <6.16.1": "6.16.1",
    "glob": {
      ".": "14.0.2",
      "minimatch": "11.0.1"
    },
    "systeminformation": "5.33.16"
  }
}
