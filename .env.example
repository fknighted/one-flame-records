# Supabase — Phase 1+
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000         # https://oneflamerecords.com in prod

# Resend — Phase 3+
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=noreply@oneflamerecords.com
ADMIN_EMAIL=admin@oneflamerecords.com    # receives new application notifications

# Inngest — Phase 4+
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Sentry error tracking — Phase 5 (add DSN from sentry.io → Project → Settings → Client Keys)
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
SENTRY_ORG=your-sentry-org-slug               # from sentry.io URL: sentry.io/organizations/{slug}/
SENTRY_PROJECT=your-sentry-project-slug       # e.g. one-flame-records
SENTRY_AUTH_TOKEN=your-sentry-auth-token      # from sentry.io → Settings → Auth Tokens (for source maps)

# YouTube — upload videos to the One Flame YouTube channel from the admin panel
# 1. Go to console.cloud.google.com → Create project → Enable YouTube Data API v3
# 2. Create OAuth 2.0 credentials (Desktop app type) → download client secret JSON
# 3. Use the OAuth Playground (developers.google.com/oauthplayground) with your credentials
#    to exchange for a refresh token with scope: https://www.googleapis.com/auth/youtube.upload
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REFRESH_TOKEN=your-youtube-refresh-token   # long-lived, store securely
